# 敏感配置：复制为 .env（已在 .gitignore，勿提交）

# 站点访问密码。留空 = 无密码（本地开发保持空）；设置后访问先过密码页（仅密码，无用户名）
ACCESS_PASSWORD=

# 管理密码（设置面板用，与站点访问密码相互独立）。留空 = 设置面板锁定；
# 设置后点右上角 ⚙ 需先验证此密码，才能改配置（如知乎 cookie）。
ADMIN_PASSWORD=

# B 站（仅游客态被风控时才需要）
BILI_SESSDATA=

# 知乎（搜索文章/回答必需登录态）。只需 z_c0 一个值：
# 浏览器登录知乎 → F12 → Application → Cookies → www.zhihu.com → 复制 z_c0 的值。
# 完整 cookie 串也可以；d_c0 会自动获取，无需包含。
# z_c0 有效期约 30 天，失效时重新登录复制一次即可。
ZHIHU_COOKIE=

# 国际源（需同时在 config.yaml 开 proxy）
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 播客目录
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
